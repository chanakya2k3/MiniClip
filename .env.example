# Copy to .env and fill in. .env is gitignored — never commit real secrets.
#
#   cp .env.example .env
#
# Only SESSION_SECRET is required. Google OAuth is optional: leave the two
# GOOGLE_* values blank and the app runs fine with password login only
# (the "Sign in with Google" button explains itself as unconfigured).

# ---- Core ------------------------------------------------------------
NODE_ENV=development
PORT=3001

# Signs the session cookie. Anyone who knows this can forge a login, so it
# must be long, random and different in every environment. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Public origin of the app. Used to build the OAuth callback URL and to
# reject cross-site state-changing requests.
APP_ORIGIN=http://localhost:3001

# ---- Database --------------------------------------------------------
# SQLite is a single file on disk. Path is relative to the project root.
DATABASE_FILE=./data/miniclip.db

# ---- Google OAuth (optional) ----------------------------------------
# From https://console.cloud.google.com/apis/credentials
#   Create an "OAuth 2.0 Client ID" of type "Web application" and add
#   http://localhost:3001/api/auth/google/callback as an authorised
#   redirect URI. The secret is a server-side value — it must never be
#   sent to the browser.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
